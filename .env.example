# ===== Supabase (예약 데이터 저장) =====
# 미설정 시 in-memory 저장소로 동작 (로컬 데모 전용 — 서버 재시작 시 데이터 소실)
# Supabase 대시보드 > Project Settings > API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role 키 (절대 클라이언트에 노출 금지)

# ===== 관리자 데스크 (/desk) =====
# 미설정 시 개발용 기본 비밀번호 'mellow' 사용 — 운영에서는 반드시 설정!
ADMIN_PASSWORD=change-me
# 세션 쿠키 서명용 비밀키 (긴 랜덤 문자열 권장)
AUTH_SECRET=long-random-string-here

# ===== 텔레그램 예약 알림 (선택) =====
# 둘 다 설정하면 새 예약이 들어올 때 텔레그램으로 알림이 옵니다. 미설정 시 알림만 생략.
# 1) 텔레그램에서 @BotFather → /newbot 으로 봇 생성 → 토큰 발급
# 2) 만든 봇에게 아무 메시지나 보낸 뒤 @userinfobot 으로 내 chat id 확인
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
TELEGRAM_CHAT_ID=123456789
